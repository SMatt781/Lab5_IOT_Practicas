<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lab_surface">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="Inventario IoT" android:background="#FFFFFF" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:orientation="vertical">
    <TextView android:id="@+id/summaryText" style="@style/LabHeading" android:text="Insumos para tu laboratorio" android:paddingTop="8dp" android:paddingBottom="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/searchEditLayout" style="@style/LabInput" android:hint="Buscar insumo">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/lowSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mostrar solo stock bajo (se recuerda)" />
    <com.google.android.material.button.MaterialButton android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir notificaciones" />
    <com.google.android.material.button.MaterialButton android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar insumo" />
    <com.google.android.material.button.MaterialButton android:id="@+id/examplesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargar 4 ejemplos si está vacío" />
    <TextView android:id="@+id/emptyText" style="@style/LabBody" android:text="No hay insumos para este filtro" android:paddingTop="8dp" android:paddingBottom="8dp" />
  </LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="12dp" />
</LinearLayout>